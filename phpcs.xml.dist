<?xml version="1.0"?>
<ruleset name="devsolution Starter Theme">

  <description>
    PHP coding standards for the devsolution Starter Theme.
  </description>

  <!-- CLI options -->
  <arg value="ps" />
  <arg name="basepath" value="./" />
  <arg name="parallel" value="8" />
  <arg name="extensions" value="php" />

  <!-- Directories and files to scan -->
  <file>theme/functions.php</file>
  <file>theme/config/</file>
  <file>theme/utils/</file>
  <file>theme/page-templates/</file>

  <!-- Ignore stuff not relevant -->
  <exclude-pattern>node_modules/*</exclude-pattern>
  <exclude-pattern>vendor/*</exclude-pattern>

  <!-- Use WordPress-related standards -->
  <rule ref="WordPress-Extra">
    <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/> 
  </rule>
  <rule ref="WordPress-Docs" />
  <rule ref="PHPCompatibilityWP" />

  <!-- PHP Compatibility / WP version -->
  <config name="testVersion" value="7.4-" />
  <config name="minimum_supported_wp_version" value="6.2" />

  <!-- Enforce correct text domain -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="ds" />
      </property>
    </properties>
  </rule>


  <!-- Recognize theme-specific files -->
  <rule ref="WordPress.Files.FileName">
    <properties>
      <property name="is_theme" value="true" />
    </properties>
  </rule>

  <rule ref="Squiz.Commenting.InlineComment.InvalidEndChar">
    <severity>0</severity>
  </rule>
</ruleset>
